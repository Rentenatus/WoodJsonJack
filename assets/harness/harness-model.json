  "abortLimits": { "maxIterations": 50, "maxDepth": 5, "maxRetries": 3, "maxToolCalls": 10 },
  "modelclasses": {
    "investigation": { "provider": "ollama", "model": "qwen3.8:27b",                  "costFactor": 1.0, "toolCapable": true },
    "edit":          { "provider": "ollama", "model": "devstral-small-2:24b",         "costFactor": 2.0, "toolCapable": true },
    "plan":          { "provider": "ollama", "model": "glm-4.7-flash:latest",         "costFactor": 1.0, "toolCapable": true },
    "evaluation":    { "provider": "ollama", "model": "granite3.3:8b",                "costFactor": 0.5, "toolCapable": false },
    "rag":           { "provider": "ollama", "model": "manutic/nomic-embed-code:latest", "costFactor": 0.2, "toolCapable": false },
    "nemotron3":     { "provider": "ollama", "model": "nemotron3:33b",                "costFactor": 1.5, "toolCapable": true },
    "gemma4":        { "provider": "ollama", "model": "gemma4:26b",                   "costFactor": 1.5, "toolCapable": true },
    "muse-glimmer":  { "provider": "ollama", "model": "muse-glimmer:30b",             "costFactor": 1.5, "toolCapable": true },
    "gemma3":        { "provider": "ollama", "model": "gemma3:27b",                   "costFactor": 1.5, "toolCapable": false },
    "gpt-oss":       { "provider": "ollama", "model": "gpt-oss:20b",                  "costFactor": 1.0, "toolCapable": true }
  },
  "quests": [
    {
      "kind": "WORK",
      "evolvable": true,
      "slots": [
        { "id": "work.base", "mutation": null,
          "calculator": { "type": "atomic", "impl": "deterministic" } },
        { "id": "work.m1", "mutation": "Mutation-Resolve-01",
