{
  "name": "default-harness",
  "version": "1.0.0",
  "taskTypes": ["AskAi", "RESEARCH", "CODE_EDIT", "TEST_RUN", "SUMMARIZE"],
  "promptBudgets": { "SYSTEM": 2, "SKILL": 1, "HISTORY": 3, "DATA": 2, "AUFTRAG": 1, "maxTokensTotal": 4000 },
  "abortLimits": { "maxIterations": 50, "maxDepth": 5, "maxRetries": 3, "maxToolCalls": 10 },
  "modelclasses": [
    { "provider": "ollama", "model": "qwen3.8:27b",                   "purpose": "investigation", "size": 27,  "costFactor": 1.0, "toolCapable": true },
    { "provider": "ollama", "model": "nemotron3:33b",                 "purpose": "investigation", "size": 33,  "costFactor": 1.5, "toolCapable": true },
    { "provider": "ollama", "model": "muse-glimmer:30b",              "purpose": "investigation", "size": 30,  "costFactor": 1.5, "toolCapable": true },
    { "provider": "ollama", "model": "devstral-small-2:24b",          "purpose": "edit",          "size": 24,  "costFactor": 2.0, "toolCapable": true },
    { "provider": "ollama", "model": "gemma4:26b",                    "purpose": "edit",          "size": 26,  "costFactor": 1.5, "toolCapable": true },
    { "provider": "ollama", "model": "glm-4.7-flash:latest",          "purpose": "plan",          "size": 30,  "costFactor": 1.0, "toolCapable": true },
    { "provider": "ollama", "model": "gpt-oss:20b",                   "purpose": "plan",          "size": 20,  "costFactor": 1.0, "toolCapable": true },
    { "provider": "ollama", "model": "granite3.3:8b",                 "purpose": "evaluation",    "size": 8,   "costFactor": 0.5, "toolCapable": false },
    { "provider": "ollama", "model": "gemma3:27b",                    "purpose": "evaluation",    "size": 27,  "costFactor": 1.5, "toolCapable": false },
    { "provider": "ollama", "model": "manutic/nomic-embed-code:latest", "purpose": "rag",        "size": 0,   "costFactor": 0.2, "toolCapable": false },
    { "provider": "ollama", "model": "phi4-mini:latest",               "purpose": "scoring",    "size": 4,   "costFactor": 0.3, "toolCapable": false }
  ],
  "quests": [
    {
      "kind": "SPLIT",
      "evolvable": false,
      "slots": [
        { "id": "askai.base", "mutation": null,
          "calculator": { "type": "puzzle", "strategy": "sequence",
            "children": [
              { "type": "atomic", "impl": "ai", "calculator": "scoring.countQuests",
                "params": { "model": "phi4-mini:latest",
                            "systemPrompt": "Count the distinct questions or tasks in the user prompt. Each clause that asks for something or requests an action is ONE quest, even when clauses are joined with \"and\"/\"und\"/\",\". Never merge joined clauses into one. Pure greetings or statements without a question or instruction count as 0. Answer with strict JSON only, no explanation: {\"status\":\"DONE\",\"decision\":\"counted\",\"score\":100,\"payload\":{\"questCount\":N}} where N is the total number of quests.",
                            "emphasisPrompt": "Attention: You must strictly adhere to the JSON structure! Answer with strict JSON only, no other text, no markdown fences." } },
              { "type": "atomic", "impl": "ai", "calculator": "askai.decompose",
                "params": { "model": "nemotron3:33b",
                            "systemPrompt": "You decompose the user prompt into {data.count} atomic quests ({data.count} = the questCount from the scoring call). Answer with strict JSON only: {\"status\":\"DONE\",\"decision\":\"decomposed\",\"score\":100,\"payload\":{\"quests\":[\"...\",\"...\"]}} where quests is the list of atomic user prompts." } },
              { "type": "atomic", "impl": "deterministic", "calculator": "printig" }
            ] } }
      ]
    },
    {
      "kind": "WORK",
      "evolvable": true,
      "slots": [
        { "id": "work.base", "mutation": null,
          "calculator": { "type": "atomic", "impl": "deterministic" } },
        { "id": "work.m1", "mutation": "Mutation-Resolve-01",
          "calculator": { "type": "puzzle", "strategy": "sequence",
            "children": [
              { "type": "atomic", "impl": "ai", "modelclass": "investigation" },
              { "type": "atomic", "impl": "deterministic", "tool": "fs.read" }
            ] } },
        { "id": "work.m2", "mutation": "Mutation-Resolve-02",
          "calculator": { "type": "atomic", "impl": "ai", "modelclass": "plan" } },
        { "id": "work.m3", "mutation": "Mutation-Resolve-03",
          "calculator": { "type": "atomic", "impl": "deterministic" } }
      ]
    },
    {
      "kind": "ABORT",
      "slots": [
        { "id": "abort", "mutation": null,
          "calculator": { "type": "atomic", "impl": "deterministic" } }
      ]
    }
  ],
  "loops": [
    { "id": "main", "items": [
      { "id": "abort",     "kind": "ABORT",     "trigger": "START"   },
      { "id": "split",     "kind": "SPLIT",     "trigger": "EXECUTE" },
      { "id": "complete",  "kind": "COMPLETE",  "trigger": "EXECUTE" },
      { "id": "work",      "kind": "WORK",      "trigger": "EXECUTE" },
      { "id": "evaluate",  "kind": "EVALUATE",  "trigger": "EXECUTE" },
      { "id": "rag_store", "kind": "RAG_STORE", "trigger": "EXECUTE" },
      { "id": "check",     "kind": "CHECK",     "trigger": "EXECUTE" },
      { "id": "summarize", "kind": "SUMMARIZE", "trigger": "EXECUTE" },
      { "id": "err",       "kind": "ABORT",     "trigger": "CATCH"   },
      { "id": "close",     "kind": "CLOSE",     "trigger": "CLOSE"   },
      { "id": "rag_prune", "kind": "RAG_PRUNE", "trigger": "CLOSE"   }
    ] }
  ]
}
